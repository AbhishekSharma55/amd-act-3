# Copy to .env (never commit .env). Values come from notebooks.amd.com/tokenfactory.
AMD_API_BASE=https://<token-factory-host>/.../v1
AMD_API_KEY=
AMD_MODEL=<model id from the portal's model list>
AMD_TIMEOUT_S=30
# Optional: "low" for thinking models, if the endpoint accepts reasoning_effort.
AMD_REASONING_EFFORT=
# Set to 0 if the model rejects response_format={"type": "json_object"}.
AMD_JSON_MODE=1

# 1 = use the labeled rule-based fallback when AMD is unavailable (never shown as AMD output).
ALLOW_RULE_FALLBACK=0

# Comma-separated origins for the Vite dev server.
CORS_ORIGINS=http://localhost:5173
FACTORY_TZ=Asia/Kolkata

# Production limits
EXTRACT_RATE_PER_MIN=12
RUN_TTL_S=21600
MAX_RUNS=2000
# SOLVER_WORKERS=2
LOG_LEVEL=INFO
