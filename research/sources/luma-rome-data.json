          "description_mirror": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Build AI agents and high-performance AI applications on AMD GPUs in the cloud and bring your project to Rome",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "The ",
                    "type": "text"
                  },
                  {
                    "text": "AMD Developer Hackathon: ACT III",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "text": " is an event for developers, founders, engineers, students, and AI builders ready to turn ambitious ideas into working products.",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "On ",
                    "type": "text"
                  },
                  {
                    "text": "October 17\u201318",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "text": ", participants will meet at ",
                    "type": "text"
                  },
                  {
                    "text": "Link Campus University in Rome",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "text": " to collaborate, receive hands-on support, and showcase their projects live.",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "text": "What you\u2019ll build",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Create an end-to-end ",
                    "type": "text"
                  },
                  {
                    "text": "AI application, agent, or developer tool powered by AMD technology",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "text": ".",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "You\u2019ll work with ",
                    "type": "text"
                  },
                  {
                    "text": "AMD GPUs in the cloud",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "text": " and the ",
                    "type": "text"
                  },
                  {
                    "text": "ROCm open-source software stack",
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "text": ". Everything runs in the cloud, so there is no local hardware to configure \u2014 you can focus on experimenting, building, and testing your idea.",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Possible directions include:",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "bullet_list",
                "content": [
                  {
                    "type": "list_item",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "AI agents and autonomous workflows",
                            "type": "text"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "list_item",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "High-performance AI and machine learning applications",
                            "type": "text"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "list_item",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Model training and fine-tuning",
                            "type": "text"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "list_item",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "AI workload benchmarking",
                            "type": "text"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "list_item",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Developer tools built around AMD\u2019s compute stack",
                            "type": "text"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "list_item",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "text": "Porting and optimizing existing AI workloads for AMD GPUs",
                            "type": "text"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Tracks and detailed challenges will be announced before the kickoff.",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "text": "Why join us in Rome?",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "The Rome edition will take place at ",
                    "type": "text"
                  },
