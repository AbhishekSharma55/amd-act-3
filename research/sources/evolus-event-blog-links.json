    "url": "/en/solutions/customer-care",
    "text": "AI for Customer Care Your support team never sleeps. Evolus replies to emails, answers calls, chats with customers \u2014 in parallel, always, without burning out."
  },
  {
    "url": "/en/solutions/commerciale",
    "text": "AI for Sales Teams Every lead answered in seconds. Every follow-up sent at the right time. Every meeting booked without friction. Evolus works for your sales team 24/7, missing no opportunity."
  },
  {
    "url": "/en/solutions/documenti",
    "text": "Document Management & Back-Office Automation Turn document management from a bottleneck into a seamless, error-free process. Evolus reads, extracts, processes and archives your documents \u2014 automatically."
  },
  {
    "url": "/en/solutions/hr",
    "text": "HR & Recruiting Automation HR teams shouldn't waste time on administrative tasks. Evolus handles emails, interviews, documents and repetitive questions \u2014 so your HR team can do the work that truly matters."
  },
  {
    "url": "/en/solutions/legale",
    "text": "Evolus for Legal From contract analysis to deadline tracking: Evolus works as an expert collaborator alongside your lawyers."
  },
  {
    "url": "/en/solutions/contabilita",
    "text": "Evolus for Accounting From incoming invoice to updated ledger: Evolus eliminates manual data entry and reduces errors to zero."
  },
